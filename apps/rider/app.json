{
  "expo": {
    "name": "Avenyn Taxi",
    "slug": "avenyn-taxi",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "avenyntaxi",
    "userInterfaceStyle": "automatic",
    "splash": {"image":"./assets/splash.png","resizeMode":"contain","backgroundColor":"#0b1f3a"},
    "assetBundlePatterns":["**/*"],
    "ios":{"supportsTablet":false,"bundleIdentifier":"se.avenyntaxi.rider","infoPlist":{"NSLocationWhenInUseUsageDescription":"Din position används för att hitta din hämtplats och visa taxin på kartan.","NSLocationAlwaysAndWhenInUseUsageDescription":"Bakgrundsposition används endast under en aktiv resa för live-spårning.","ITSAppUsesNonExemptEncryption":false}},
    "android":{"adaptiveIcon":{"foregroundImage":"./assets/adaptive-icon.png","backgroundColor":"#0b1f3a"},"package":"se.avenyntaxi.rider","permissions":["ACCESS_FINE_LOCATION","ACCESS_COARSE_LOCATION"]},
    "web":{"favicon":"./assets/favicon.png"},
    "plugins":["expo-location","expo-secure-store"],
    "extra":{"defaultLocale":"sv-SE","brand":"Avenyn Taxi"}
  }
}
